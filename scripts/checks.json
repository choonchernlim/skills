{
  "requires": ["git"],
  "inert": [".gitignore", "LICENSE", "CLAUDE.md", ".idea/*", ".agents/*", ".claude/*", ".codex/*", "specs/*"],
  "checks": [
    {
      "id": "docsmith-selftest",
      "cmd": ["python3", "skills/docsmith/scripts/test_lint_docs.py"],
      "parse": "blocks",
      "paths": ["skills/docsmith/*"]
    },
    {
      "id": "tokenminator-selftest",
      "cmd": ["python3", "skills/tokenminator/scripts/test_audit_tokens.py"],
      "parse": "blocks",
      "paths": ["skills/tokenminator/*"]
    },
    {
      "id": "tokenminator-assets",
      "cmd": ["python3", "skills/tokenminator/scripts/test_assets.py"],
      "parse": "blocks",
      "paths": ["skills/tokenminator/assets/*", "skills/tokenminator/scripts/test_assets.py", "scripts/*"]
    },
    {
      "id": "grill-me-selftest",
      "cmd": ["python3", "skills/grill-me/scripts/test_next_version.py"],
      "parse": "blocks",
      "paths": ["skills/grill-me/*"]
    },
    {
      "id": "grill-me-worktree",
      "cmd": ["python3", "skills/grill-me/scripts/test_new_worktree.py"],
      "parse": "blocks",
      "paths": ["skills/grill-me/*"]
    },
    {
      "id": "research-selftest",
      "cmd": ["python3", "skills/research/scripts/test_check_research.py"],
      "parse": "blocks",
      "paths": ["skills/research/*"]
    },
    {
      "id": "research-files",
      "cmd": ["python3", "skills/research/scripts/check_research.py", "{glob:specs/*/research.md}"],
      "parse": "located",
      "paths": ["specs/*/research.md", "skills/research/scripts/check_research.py"]
    },
    {
      "id": "agents-paths",
      "cmd": ["python3", "scripts/test_agents_md.py"],
      "parse": "blocks",
      "paths": ["AGENTS.md", "scripts/*", "skills/*"]
    },
    {
      "id": "docs-lint",
      "cmd": ["python3", "skills/docsmith/scripts/lint_docs.py", "README.md", "{glob:skills/*/references/*.md}"],
      "parse": "located",
      "paths": ["README.md", "skills/*/references/*", "skills/docsmith/scripts/lint_docs.py"]
    }
  ]
}
