{
  "bashOutputMaxChars": 10000,
  "permissions": {
    "deny": [
      "Read(**/package-lock.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook.py session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook.py stop"
          }
        ]
      }
    ]
  }
}
